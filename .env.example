# Copy to .env.local for local development. In Vercel, add these under
# Project Settings > Environment Variables. Never commit real values.

# --- Sanity (required for CMS content; the site falls back to built-in copy without it)
# Sanity project ID and dataset (public, safe to expose to the browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Shared secret for the /api/revalidate webhook (set the same value in the Sanity webhook)
SANITY_REVALIDATE_SECRET=

# --- Site
# Public URL used for canonical links, sitemap and Open Graph images
NEXT_PUBLIC_SITE_URL=https://ttrdigitalmarketing.com
# Placeholder blocks ([LIKE THIS]) are hidden by default. "true" shows them, for review on previews only.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=false

# --- GoHighLevel (lead form). Without any of these, leads are accepted but not sent anywhere.
# Inbound webhook (Automation > Workflows > trigger "Inbound Webhook"). Every form
# submission is POSTed here as flat JSON. Keep it out of the code: the repo is public.
GHL_WEBHOOK_URL=
# Optional, in addition to the webhook: direct API delivery (contact upsert + tags + note).
# Sub-account (location) ID from GoHighLevel > Settings > Business Profile
GHL_LOCATION_ID=
# Private Integration token (Settings > Private Integrations) with the contacts.write scope
GHL_API_KEY=

# --- Analytics (optional; nothing loads when empty; loads on first interaction)
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Google Tag Manager container ID, e.g. GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=
