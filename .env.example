# Copy to .env.local for local development. In Vercel, add these under
# Project Settings > Environment Variables. Never commit real values.

# --- Sanity (required for CMS content; the site falls back to built-in copy without it)
# Sanity project ID and dataset (public, safe to expose to the browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Shared secret for the /api/revalidate webhook (set the same value in the Sanity webhook)
SANITY_REVALIDATE_SECRET=

# --- Site
# Public URL used for canonical links, sitemap and Open Graph images
NEXT_PUBLIC_SITE_URL=https://www.ttrdigitalmarketing.com
# Placeholder blocks ([LIKE THIS]) are hidden by default. "true" shows them, for review on previews only.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=false

# --- TTR OS (lead form). Leads are sent to https://ttr-portal.vercel.app/api/site/form.
# The site key is public and built in (lib/ttr-site-key.ts). Set it only to use a different key; "off" turns TTR OS off.
NEXT_PUBLIC_TTR_SITE_KEY=
# Optional: a different form endpoint.
TTR_OS_FORM_URL=

# --- Human check on the lead form (Google reCAPTCHA v3).
# The public site key is built in (lib/recaptcha.ts); set this only to use a different key.
RECAPTCHA_SITE_KEY=
# Secret key from the reCAPTCHA admin console. Keep it private; never commit it.
RECAPTCHA_SECRET_KEY=

# --- Analytics (optional; nothing loads when empty; loads on first interaction)
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Google Tag Manager container ID, e.g. GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=
